NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://borderless:borderless@localhost:5432/borderless
# FX provider (no API key needed). Set FX_PROVIDER=static to run fully offline.
FX_PROVIDER=live
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_SECONDS=300
FX_PROVIDER_TIMEOUT_MS=3000
FX_MAX_STALENESS_SECONDS=86400
